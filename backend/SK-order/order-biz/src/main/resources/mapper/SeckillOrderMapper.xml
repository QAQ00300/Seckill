<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seckill.order.biz.mapper.SeckillOrderMapper">

    <resultMap id="BaseResultMap" type="com.seckill.order.bo.eo.SeckillOrderEO">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="seckill_id" property="seckillId"/>
        <result column="product_id" property="productId"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="seckill_price" property="seckillPrice"/>
        <result column="quantity" property="quantity"/>
        <result column="total_price" property="totalPrice"/>
        <result column="order_status" property="orderStatus"/>
        <result column="pay_time" property="payTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据订单号查询 -->
    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT * FROM `order`
        WHERE order_no = #{orderNo} AND is_deleted = 0
    </select>

    <!-- 根据用户 ID 查询 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM `order`
        WHERE user_id = #{userId} AND is_deleted = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据秒杀活动 ID 查询 -->
    <select id="selectBySeckillId" resultMap="BaseResultMap">
        SELECT * FROM `order`
        WHERE seckill_id = #{seckillId} AND is_deleted = 0
    </select>

    <!-- 更新订单状态 -->
    <update id="updateOrderStatus">
        UPDATE `order`
        SET order_status = #{status}, update_time = NOW()
        WHERE order_no = #{orderNo} AND is_deleted = 0
    </update>

    <!-- 逻辑删除订单 -->
    <update id="deleteByOrderNo">
        UPDATE `order`
        SET is_deleted = 1, update_time = NOW()
        WHERE order_no = #{orderNo}
    </update>

    <!-- 统计用户订单数量 -->
    <select id="countByUserIdAndSeckillId" resultType="long">
        SELECT COUNT(1) FROM `order`
        WHERE user_id = #{userId}
          AND seckill_id = #{seckillId}
          AND is_deleted = 0
    </select>

</mapper>