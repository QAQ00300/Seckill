

# MySQL 配置
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=seckill
MYSQL_USERNAME=root
MYSQL_PASSWORD=Ppg123456

# Redis 配置
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=Ppg123456


# Nacos 配置
NACOS_SERVER_ADDR=1Panel-nacos-1742-standalone:8848
NACOS_NAMESPACE=public
SPRING_CLOUD_NACOS_DISCOVERY_ENABLED=true

# 应用配置
SPRING_PROFILES_ACTIVE=dev
