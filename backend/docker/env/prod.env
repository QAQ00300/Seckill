# 生产环境变量配置
# ⚠️ 重要：此文件包含敏感信息，不应提交到 Git 仓库

# 数据库配置（必须使用强密码）
MYSQL_ROOT_PASSWORD=YourProductionPassword!2024#Secure
MYSQL_DATABASE=seckill
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Nacos 配置
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=production

# 应用配置
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=WARN

# JVM 配置（生产环境优化）
JAVA_OPTS=-Xmx1g -Xms1g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof

# 日志配置
LOG_PATH=/app/logs
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=30

# 监控配置
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator

