# 开发环境变量配置
# 说明：仅用于本地开发环境

# 数据库配置
MYSQL_ROOT_PASSWORD=Ppg123456
MYSQL_DATABASE=seckill
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Nacos 配置（开发环境不启用）
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=public

# 应用配置
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# JVM 配置
JAVA_OPTS=-Xmx256m -Xms256m -Duser.timezone=Asia/Shanghai